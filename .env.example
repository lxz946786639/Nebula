# Nebula 生产环境配置示例
# 使用方式：复制为 .env 后再启动 Docker Compose。
# 标记说明：
#   【必改】生产环境首次部署前必须修改，否则后端会拒绝使用默认弱配置启动。
#   【按需修改】根据部署方式、域名、端口或安全策略调整。
#   【可保持默认】大多数场景可以先保持默认值。

# ===== 基础运行环境 =====
# 【可保持默认】生产环境固定为 production；本地开发可使用 development。
APP_ENV=production
# 【可保持默认】生产环境不要开启不安全默认值；仅可信本地临时测试才可改为 true。
ALLOW_INSECURE_DEFAULTS=false
# 【可保持默认】容器和后端统一使用中国时区。
TZ=Asia/Shanghai

# ===== 账号与密钥 =====
# 【必改】JWT 签名密钥，至少 32 位随机字符串；示例：openssl rand -hex 32。
SECRET_KEY=replace-with-random-secret-at-least-32-chars
# 【建议修改】首次初始化的管理员用户名；已初始化后修改不会重命名已有用户。
ADMIN_USERNAME=admin
# 【必改】首次初始化的管理员密码，至少 12 位强密码；已初始化后修改不会自动改旧密码。
ADMIN_PASSWORD=replace-with-strong-password
# 【必改】公开订阅接口 Token，至少 24 位随机字符串；泄露后请在系统设置中同步更换。
SUBSCRIPTION_TOKEN=replace-with-random-token-at-least-24-chars

# ===== 数据库与缓存 =====
# 【可保持默认】SQLite 数据库文件保存在 backend/data/nebula.db。
DATABASE_URL=sqlite+aiosqlite:///./data/nebula.db
# 【可保持默认】是否打印 SQL 调试日志；生产环境建议 false。
SQL_ECHO=false
# 【可保持默认】Docker Compose 内部使用服务名 redis 访问 Redis。
REDIS_URL=redis://redis:6379/0
# 【可保持默认】缓存有效期，单位秒。
CACHE_TTL_SECONDS=600

# ===== 订阅转换服务 =====
# 【可保持默认】Docker Compose 内部使用服务名 subconverter。
SUBCONVERTER_URL=http://subconverter:25500
# 【可保持默认】订阅转换超时时间，单位秒。
SUBCONVERTER_TIMEOUT_SECONDS=45
# 【按需修改】默认使用 ACL4SSR 在线规则；如网络不可达，可改为自托管规则地址。
ACL4SSR_CONFIG_URL=https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Online.ini

# ===== Mihomo 核心与运行时 =====
# 【可保持默认】Docker Compose 内部使用服务名 mihomo。
MIHOMO_API_URL=http://mihomo:9090
# 【按需修改】Mihomo External Controller 密钥；如果给 Mihomo 配了 secret，这里必须保持一致。
MIHOMO_API_SECRET=
# 【可保持默认】Nebula 生成的运行时配置路径，位于后端容器内。
MIHOMO_RUNTIME_CONFIG_PATH=/app/data/mihomo-runtime.yaml
# 【可保持默认】Mihomo 实际加载的运行时配置路径，位于 Mihomo 容器内。
MIHOMO_CORE_CONFIG_PATH=/root/.config/mihomo/mihomo-runtime.yaml
# 【可保持默认】Ant 内部适配器地址自动判断；跨主机部署或本地 Docker Desktop 特殊网络时再指定。
ANT_ADAPTER_BIND_HOST=
ANT_ADAPTER_CONNECT_HOST=
# 【可保持默认】账号登录的蚂蚁节点是否启用后台自动刷新。
ANT_PROXY_AUTO_REFRESH_ENABLED=true
# 【可保持默认】账号登录的蚂蚁节点后台刷新间隔，单位分钟；默认 6 小时。
ANT_PROXY_AUTO_REFRESH_INTERVAL_MINUTES=360

# ===== 智能代理端口与调度 =====
# 【按需修改】智能代理和蚂蚁代理共用的端口池起止范围；修改后需同时保证 Docker 端口映射可用。
SMART_PROXY_PORT_START=37890
SMART_PROXY_PORT_END=37900
# 【可保持默认】定时检查 Mihomo runtime 的间隔，单位分钟；仅内容变化时重载，0 表示关闭定时检查。
SMART_PROXY_AUTO_APPLY_INTERVAL_MINUTES=0
# 【可保持默认】智能代理运行状态监控间隔，单位分钟；0 表示关闭监控。
SMART_PROXY_MONITOR_INTERVAL_MINUTES=1
# 【可保持默认】启用订阅流量保护：到期或流量耗尽的订阅节点会从智能代理候选中排除。
SMART_PROXY_TRAFFIC_GUARD_ENABLED=true
# 【可保持默认】剩余流量小于等于该值时排除节点，单位 MB；0 表示仅在真实耗尽时排除。
SMART_PROXY_MIN_REMAINING_MB=0
# 【可保持默认】剩余流量小于等于该值时降权排序，单位 MB。
SMART_PROXY_LOW_REMAINING_MB=2048
# 【可保持默认】订阅将在该天数内到期时降权排序。
SMART_PROXY_EXPIRE_SOON_DAYS=3
# 【按需修改】订阅没有流量响应头时是否直接排除；部分机场不返回流量头，默认不排除。
SMART_PROXY_EXCLUDE_UNKNOWN_TRAFFIC=false

# ===== 访问地址与端口映射 =====
# 【按需修改】前端页面和本地开发地址的跨域白名单，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
# 【按需修改】前端管理后台绑定地址；局域网访问可改为 0.0.0.0，并务必配置强密码和防火墙。
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8088
# 【按需修改】后端 API 暴露到宿主机的绑定地址；生产环境建议保持 127.0.0.1。
INTERNAL_BIND_HOST=127.0.0.1
BACKEND_PORT=8001
# 【按需修改】仅启用 docker-compose.debug.yml 时生效，用于本机调试 Redis、subconverter、Mihomo API。
DEBUG_BIND_HOST=127.0.0.1
REDIS_PORT=6379
SUBCONVERTER_PORT=25500
MIHOMO_API_PORT=9090
# 【按需修改】智能代理端口绑定地址；如需给局域网设备使用可改为 0.0.0.0，并配合防火墙限制来源。
SMART_PROXY_BIND_HOST=127.0.0.1

# ===== 订阅 URL 安全策略 =====
# 【可保持默认】阻止订阅 URL 访问内网、回环和链路本地地址，防止 SSRF。
URL_BLOCK_PRIVATE_NETWORKS=true
# 【按需修改】订阅域名白名单，多个域名用英文逗号分隔；为空表示不限制公网域名。
URL_ALLOWLIST=

# ===== API 限流 =====
# 【可保持默认】限流窗口内允许的最大请求数。
RATE_LIMIT_REQUESTS=180
# 【可保持默认】限流窗口长度，单位秒。
RATE_LIMIT_WINDOW_SECONDS=60
# 【按需修改】反向代理后是否信任 X-Real-IP / X-Forwarded-For；公网直连时建议 false。
RATE_LIMIT_TRUST_PROXY_HEADERS=true
