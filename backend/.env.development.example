# Nebula 后端本地开发环境配置示例
# 使用方式：复制为 backend/.env.development 后，再在宿主机直接启动后端。
# 本文件只面向本地开发；生产部署请使用根目录 .env.example。

# ===== 基础运行环境 =====
# 【可保持默认】本地开发模式。
APP_ENV=development
# 【可保持默认】与生产环境保持一致，避免日志和调度时间出现 8 小时偏差。
TZ=Asia/Shanghai

# ===== 数据库 =====
# 【可保持默认】开发环境使用 backend/data/nebula.db。
DATABASE_URL=sqlite+aiosqlite:///./data/nebula.db
# 【按需修改】调试 SQL 时可改为 true。
SQL_ECHO=false

# ===== 本地依赖服务 =====
# 【可保持默认】仅在启用 docker-compose.debug.yml 或自行暴露 Redis 端口后可用；如 Redis 设置密码，请改成 redis://:密码@127.0.0.1:6379/0。
REDIS_URL=redis://127.0.0.1:6379/0
# 【可保持默认】仅在启用 docker-compose.debug.yml 或自行暴露 subconverter 端口后可用。
SUBCONVERTER_URL=http://127.0.0.1:25500

# ===== Mihomo 开发配置 =====
# 【可保持默认】仅在启用 docker-compose.debug.yml 或自行暴露 Mihomo API 端口后可用。
MIHOMO_API_URL=http://127.0.0.1:9090
# 【按需修改】本地 Mihomo 配置了 secret 时必须填写，并与 Mihomo 保持一致。
MIHOMO_API_SECRET=
# 【可保持默认】后端生成的 runtime 配置文件路径。
MIHOMO_RUNTIME_CONFIG_PATH=./data/mihomo-runtime.yaml
# 【按需修改】Mihomo 实际加载的配置路径；宿主机直连本地 Mihomo 时请改成本机真实路径。
MIHOMO_CORE_CONFIG_PATH=/root/.config/mihomo/mihomo-runtime.yaml

# ===== 前端跨域 =====
# 【可保持默认】允许 Vite 开发端口和 Docker 前端端口访问后端 API。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
