# Local development configuration.
# Copy this file to backend/.env.development before running the backend on the host machine.

APP_ENV=development
TZ=Asia/Shanghai
DATABASE_URL=sqlite+aiosqlite:///./data/nebula.db
SQL_ECHO=false

REDIS_URL=redis://127.0.0.1:6379/0
SUBCONVERTER_URL=http://127.0.0.1:25500
MIHOMO_API_URL=http://127.0.0.1:9090
MIHOMO_RUNTIME_CONFIG_PATH=./data/mihomo-runtime.yaml
MIHOMO_CORE_CONFIG_PATH=/root/.config/mihomo/mihomo-runtime.yaml

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
